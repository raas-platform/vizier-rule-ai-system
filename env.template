# VizierAI Rule Validation API - 프로덕션 환경 설정

# ====== 기본 설정 ======
# development, staging, production
ENVIRONMENT=production
DEBUG=false

# ====== 서버 설정 ======
HOST=0.0.0.0
PORT=8000
# CPU 코어 수 * 2 권장
WORKERS=4
# debug, info, warning, error
LOG_LEVEL=info

# ====== 보안 설정 ======
# CORS 설정 (프로덕션에서는 특정 도메인만 허용)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,app.yourdomain.com,localhost
# Vizier 화면 CORS 허용 Origin (콤마 구분). 비워 두면 기본값 사용:
# https://dev.vizier-service.com, https://demo.vizier-service.com, https://prod.vizier-service.com
# production이 아니면 localhost/127.0.0.1(모든 포트)도 허용됩니다.
# CORS_ALLOWED_ORIGINS=https://dev.vizier-service.com,https://demo.vizier-service.com,https://prod.vizier-service.com
# CloudFront 뒤에서 실제 클라이언트 IP 판별 (기본 꺼짐).
# true면 CloudFront를 거친 요청의 X-Forwarded-For 마지막 IP를 IP 제한에 쓴다.
# CLOUDFRONT_ORIGIN_SECRET은 CloudFront 오리진 사용자 지정 헤더(X-Origin-Verify) 값과 같게. 운영 권장.
# TRUST_CLOUDFRONT=false
# CLOUDFRONT_ORIGIN_SECRET=

# Secret Key (임의의 긴 문자열)
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# ====== AI 서비스 API 키 ======
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ====== 데이터베이스 설정 ======
DATABASE_URL=sqlite:///./vizierai.db

# PostgreSQL (프로덕션 권장)
# DATABASE_URL=postgresql://user:password@localhost:5432/vizierai_db

# ====== 캐싱 설정 ======
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_here
# 1시간 (초)
CACHE_TTL=3600

# ====== 모니터링 및 로깅 ======
# 오류 추적
SENTRY_DSN=your_sentry_dsn_here
LOG_FILE=logs/vizierai.log
MAX_LOG_SIZE=50MB
LOG_BACKUP_COUNT=5

# ====== 성능 설정 ======
# 10MB
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30
AI_TIMEOUT=60
MAX_CONCURRENT_REQUESTS=100

# ====== AI 모델 설정 ======
DEFAULT_MODEL=claude-sonnet-5-5
FALLBACK_MODEL=gpt-6.1-sol
MAX_TOKENS=4000
TEMPERATURE=0.7

# ====== 검증 리포트 (POST /rules/report/stream) ======
# 리포트는 ANTHROPIC_API_KEY로 Claude를 호출합니다.
REPORT_MODEL=claude-opus-5-5
# low / medium / high / xhigh / max
REPORT_EFFORT=low
REPORT_MAX_TOKENS=32000
# 리포트 한 건 전체 시간 상한(초)
REPORT_TOTAL_TIMEOUT_SECONDS=120
# 서버 간 호출 키. 설정하면 X-API-Key 헤더가 같을 때 한도 없이 허용
REPORT_API_KEY=
# 키 없이 부를 수 있는 브라우저 Origin(쉼표 구분, file://로 연 화면은 null).
# 비워 두면 CORS_ALLOWED_ORIGINS(기본: Vizier dev/demo/prod)를 그대로 씁니다
REPORT_ALLOWED_ORIGINS=
# 브라우저 호출 한도: IP당 분당 호출 수, 하루(KST 자정 기준) 전체 생성 건수
REPORT_RATE_PER_MINUTE=5
REPORT_DAILY_LIMIT=100

# ====== Rate Limiting ======
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ====== SSL/TLS 설정 ======
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# ====== Nginx 설정 (선택사항) ======
NGINX_CLIENT_MAX_BODY_SIZE=10m
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ====== Docker 설정 ======
COMPOSE_PROJECT_NAME=vizierai
DOCKER_REGISTRY=your-registry.com/vizierai

# ====== 백업 설정 ======
BACKUP_ENABLED=true
# 매일 새벽 2시
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# ====== 알림 설정 ======
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@yourdomain.com
EMAIL_PASSWORD=your_email_password_here
ADMIN_EMAIL=admin@yourdomain.com

# ====== 헬스체크 설정 ======
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3 